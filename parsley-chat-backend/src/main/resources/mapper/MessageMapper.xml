<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.parsley.parsley_chat.mapper.MessageMapper">

    <insert id="saveMessage" parameterType="com.parsley.parsley_chat.entity.Message">
        INSERT INTO message (
            id,
            room_id,
            sender_id,
            sender_name,
            content,
            time_stamp
        )
        VALUES (
            #{id},
            #{roomId},
            #{senderId},
            #{senderName},
            #{content},
            #{timestamp}
        )
    </insert>

    <select id="getChatHistoryByRoomId" resultType="com.parsley.parsley_chat.entity.Message">
        SELECT *
        FROM message
        WHERE room_id = #{roomId}
    </select>

</mapper>